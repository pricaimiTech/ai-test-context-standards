{
  "name": "qa-ai-lib",
  "version": "1.0.0",
  "type": "module",
  "compilerOptions": {
    "target": "ES2022", /* Alvo moderno para suportar async/await e features novas */
    "module": "NodeNext", /* CRUCIAL: Habilita suporte nativo a ES Modules (import/export) */
    "moduleResolution": "NodeNext",
    /* Pastas */
    "outDir": "./dist", /* Compila para a pasta dist */
    "rootDir": "./src", /* Lê os arquivos da pasta src (Corrigido de bin) */
    /* Interoperabilidade */
    "esModuleInterop": true, /* Ajuda com pacotes legados */
    "resolveJsonModule": true, /* Permite importar .json */
    /* Qualidade de Código (Strict) */
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true, /* Ignora checagem profunda em node_modules para buildar rápido */
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ], /* Apenas arquivos dentro de src */
  "exclude": [
    "node_modules",
    "dist"
  ]
}