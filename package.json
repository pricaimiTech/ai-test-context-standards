{
  "name": "ai-test-context-standards",
  "version": "1.0.0",
  "description": "A CLI that injects optimized QA patterns and test context to guide AIs in generating automated tests.",
  "main": "dist/index.js",
  "bin": {
    "ai-test-standards": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && copyfiles -u 1 src/**/*.md dist",
    "build:clean": "rm -rf dist && npm run build",
    "qa:review": "node dist/cli.js review",
    "qa:plan": "node dist/cli.js plan",
    "qa:spec": "node dist/cli.js spec",
    "qa:check": "node dist/cli.js check-connection",
    "qa:test-ai": "node dist/cli.js test-ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qajonatasmartins/ai-test-context-standards.git"
  },
  "keywords": [
    "qa-automation",
    "typescript",
    "prompt-engineering",
    "ai-context",
    "testing-standards",
    "software-quality",
    "scaffolding",
    "llm-ops"
  ],
  "author": "qajonatasmartins",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/qajonatasmartins/ai-test-context-standards/issues"
  },
  "homepage": "https://github.com/qajonatasmartins/ai-test-context-standards#readme",
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "openai": "^6.9.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "copyfiles": "^2.4.1",
    "typescript": "^5.9.3"
  }
}
